# SECURITY
API_KEY=sk-ibvap-local-dev-key
JWT_SECRET=super-secret-local-dev-key-12345
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# MODEL & RUNTIME
MODEL_PATH=C:\optic-sheild\backend
YOLO_MODEL=yolov8n.pt
REID_MODEL=osnet_x0_25_msmt17.pt
DEVICE=cuda:0
LOG_LEVEL=INFO
ENVIRONMENT=development

# DETECTION TUNING
CONFIDENCE_THRESHOLD=0.4
IOU_THRESHOLD=0.5
MAX_DETECTIONS=100

# WEBSOCKET & UPLOAD
WS_FRAME_INTERVAL=1.0
WS_JPEG_QUALITY=60
WS_MAX_CLIENTS=2
WS_JPEG_QUALITY=80
UPLOAD_DIR=C:\optic-sheild\backend\uploads
MAX_UPLOAD_SIZE=104857600

# GPU
CUDA_VISIBLE_DEVICES=0